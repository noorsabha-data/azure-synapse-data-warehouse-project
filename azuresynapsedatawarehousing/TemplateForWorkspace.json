			"properties": {
				"activities": [
					{
						"name": "DataTransformation",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "Dataflow",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"source1": {},
									"silverDestination": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					},
					{
						"name": "SilverTable",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "DataTransformation",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "ls_serverless",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "IF NOT EXISTS(SELECT * FROM sys.tables t JOIN sys.schemas s ON t.schema_id = s.schema_id \nWHERE t.name = 'silverTable' AND s.name = 'silver' )\n    CREATE EXTERNAL TABLE silver.silverTable\n    (\n        OrderID          VARCHAR(100),\n        OrderDate        DATE,\n        CustomerID       VARCHAR(100),\n        CustomerName     VARCHAR(100),\n        CustomerEmail    VARCHAR(100),\n        ProductID        VARCHAR(100),\n        ProductName      VARCHAR(100),\n        ProductCategory  VARCHAR(100),\n        RegionID         VARCHAR(100),\n        RegionName       VARCHAR(100),\n        Country          VARCHAR(100),\n        Quantity         VARCHAR(100),\n        UnitPrice        BIGINT,\n        TotalAmount      VARCHAR(100),\n        Domain           VARCHAR(100)\n    )\n    WITH\n    (\n        LOCATION = 'enriched_sales',\n        DATA_SOURCE = silver_source,\n        FILE_FORMAT = parquet_format\n    );\n\n\n\n\n",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-08-28T22:34:02Z"
			},
			"dependsOn": [
				"[concat(variables('workspaceId'), '/dataflows/Dataflow')]",
				"[concat(variables('workspaceId'), '/linkedServices/ls_serverless')]"
			]
		},
